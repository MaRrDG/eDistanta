# ============================================
# Web Environment Variables (.env.web.example)
# ============================================

# API Connection
VITE_API_BASE_URL=https://api.edistanta.ro

# Weather API
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_WEATHER_API_URL=https://api.weatherapi.com/v1

# Routing Service (OSRM)
VITE_OSRM_URL=https://router.project-osrm.org/route/v1/driving

# Geocoding Service (Nominatim)
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Site URL (used for SEO, sitemaps, etc.)
VITE_SITE_URL=https://edistanta.ro
