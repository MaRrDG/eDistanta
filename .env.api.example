# ===========================================
# API Environment Variables (.env.api.example)
# ===========================================

# Server Configuration
NODE_ENV=production
PORT=9001
API_BASE_URL=http://localhost:9001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edisanta_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# Fuel Price Scraping Configuration
FUEL_PRICE_URL=https://www.peco-online.ro/index.php
SCRAPING_CRON_SCHEDULE=12 21 * * *
SCRAPING_ENABLED=true

# Scraping API Key (required to trigger manual scraping)
SCRAPE_API_KEY=generate-a-strong-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=https://edistanta.ro
